{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@leohenon/opencode-vim-plugin",
  "version": "0.2.0-beta.3",
  "description": "Vim mode plugin for OpenCode.",
  "keywords": [
    "opencode",
    "plugin",
    "tui",
    "vim"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leohenon/opencode-vim-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/leohenon/opencode-vim-plugin/issues"
  },
  "homepage": "https://leohenon.github.io/opencode-vim/",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run script/build.ts",
    "typecheck": "tsc --noEmit",
    "check:adapter": "bun run script/check-adapter.ts",
    "check": "bun run typecheck && bun run test && bun run build && bun run check:adapter",
    "prepack": "bun run check"
  },
  "engines": {
    "opencode": ">=2.0.25"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.25",
    "@opentui/core": ">=0.5.16",
    "@opentui/solid": ">=0.5.16"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.25",
    "@opencode/theme": "2.0.25",
    "@opentui/core": "0.5.16",
    "@opentui/solid": "0.5.16",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0"
  }
}
